# Application
DJANGO_ENVIRONMENT=development
# Homologação: use DJANGO_ENVIRONMENT=staging com os mesmos requisitos de segurança da produção.
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=True
DJANGO_LOG_LEVEL=INFO

# Security and origins
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Privacy
PRIVACY_POLICY_VERSION=2026-08-20-v1

# Database
POSTGRES_DB=repage
POSTGRES_USER=repage
POSTGRES_PASSWORD=repage-local-only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Produção: endpoint direto exclusivo para migrations, backup e restore.
POSTGRES_DIRECT_HOST=
POSTGRES_DIRECT_PORT=
POSTGRES_SSLMODE=prefer

# Static files
DJANGO_STATIC_ROOT=./staticfiles

# Lead idempotency
IDEMPOTENCY_TTL_SECONDS=86400
LEAD_DUPLICATE_WINDOW_SECONDS=300

# Lead protection
LEAD_MIN_SUBMISSION_SECONDS=2
LEAD_RATE_LIMIT_IP_SHORT_COUNT=5
LEAD_RATE_LIMIT_IP_SHORT_WINDOW_SECONDS=600
LEAD_RATE_LIMIT_IP_DAILY_COUNT=20
LEAD_RATE_LIMIT_IP_DAILY_WINDOW_SECONDS=86400
LEAD_RATE_LIMIT_EMAIL_COUNT=3
LEAD_RATE_LIMIT_EMAIL_WINDOW_SECONDS=1800
LEAD_RATE_LIMIT_PHONE_COUNT=3
LEAD_RATE_LIMIT_PHONE_WINDOW_SECONDS=1800

# Email addresses
EMAIL_FROM_ADDRESS=contatolukasfrick@gmail.com
EMAIL_FROM_NAME=Repage
EMAIL_INTERNAL_RECIPIENT=contatolukasfrick@gmail.com

# Email backend / SMTP
# Staging força o backend locmem e não usa EMAIL_HOST, EMAIL_HOST_USER ou EMAIL_HOST_PASSWORD.
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=5

# Email retry
EMAIL_DELIVERY_LEASE_SECONDS=300
EMAIL_RETRY_BATCH_SIZE=10
EMAIL_RETRY_DELAY_1_SECONDS=900
EMAIL_RETRY_DELAY_2_SECONDS=3600
EMAIL_RETRY_DELAY_3_SECONDS=21600
EMAIL_RETRY_DELAY_4_SECONDS=86400
