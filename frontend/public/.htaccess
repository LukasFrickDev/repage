RewriteEngine On

# Canonical host first so www goes directly to HTTPS apex.
RewriteCond %{HTTP_HOST} ^www\.repage\.com\.br$ [NC]
RewriteRule ^ https://repage.com.br%{REQUEST_URI} [R=301,L,NE]

# Redirect the apex to HTTPS when the hosting layer does not do it first.
RewriteCond %{HTTP_HOST} ^repage\.com\.br$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://repage.com.br%{REQUEST_URI} [R=301,L,NE]

# Prerendered route directories are canonical without a trailing slash.
# Asset directories keep their existing static-file behavior.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} /$
RewriteCond %{REQUEST_URI} !^/(?:assets|brands|fonts|projects|seo)(?:/|$) [NC]
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

# Serve the prerendered document directly so mod_dir does not apply
# DirectorySlash to the canonical no-slash URL.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !^/(?:assets|brands|fonts|projects|seo)(?:/|$) [NC]
RewriteRule ^(.+)$ $1/index.html [L]

ErrorDocument 404 /404.html

<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/assets/[^/]+-[A-Za-z0-9_-]{8,}\.[A-Za-z0-9]+$" repage_vite_asset=1
  SetEnvIf Request_URI "^/(?:brands|fonts|projects|seo)/" repage_stable_asset=1
  SetEnvIf Request_URI "^/fonts/instrument-sans/InstrumentSans-Variable\.aa72922aafcc\.woff2$" repage_versioned_font=1
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header always set Cache-Control "no-cache"
  </FilesMatch>
  Header always set Cache-Control "no-cache" env=repage_stable_asset
  Header always set Cache-Control "public, max-age=31536000, immutable" env=repage_versioned_font
  Header always set Cache-Control "public, max-age=31536000, immutable" env=repage_vite_asset

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "DENY"
</IfModule>
