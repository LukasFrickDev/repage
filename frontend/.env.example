# Public build configuration — never place secrets in this file.

# API
VITE_API_BASE_URL=http://localhost:8000

# Optional GA4 configuration. Analytics remains disabled when empty.
VITE_GA_MEASUREMENT_ID=

# Privacy
VITE_PRIVACY_POLICY_VERSION=pre-launch-v1

# SEO — only the literal "true" enables global indexing.
VITE_SITE_INDEXING_ENABLED=false
